# URL of the Django backend (no trailing slash) -- your Oracle Cloud
# instance's public hostname/IP behind TLS, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# Supabase project settings -> API Keys.
# Safe to expose in the frontend bundle -- the publishable key only grants
# what your Supabase RLS policies (or, here, the Django backend's own auth
# checks) allow.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# New projects: Settings -> API Keys -> "Publishable key" (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older projects that haven't migrated off legacy keys yet: use the "anon"
# key instead (Settings -> API Keys -> Legacy API Keys tab) --
# VITE_SUPABASE_PUBLISHABLE_KEY takes priority if both are set.
VITE_SUPABASE_ANON_KEY=
