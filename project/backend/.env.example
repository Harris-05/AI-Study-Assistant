# ══════════════════════════════════════════════════════════
# Django / deployment (Oracle Cloud compute instance)
# ══════════════════════════════════════════════════════════
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public hostname of the Oracle Cloud instance once you have a domain/TLS
# in front of it (Nginx + certbot, or a Cloudflare tunnel) -- adds itself to
# DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS automatically.
PUBLIC_HOSTNAME=

# SQLite path -- only used if DATABASE_URL (below) is empty, i.e. local dev
# without Supabase configured yet.
SQLITE_PATH=

# Where uploaded files + pipeline work/ output (audio, transcripts, the
# Chroma vector index) live ON THE ORACLE INSTANCE'S OWN DISK. This must be
# a real persistent path -- e.g. a mounted OCI Block Volume -- since Chroma
# is an embedded/local vector store, not a hosted one. Defaults to
# backend/media if unset.
MEDIA_ROOT=/data/lecture-companion/media

# ══════════════════════════════════════════════════════════
# Supabase
# ══════════════════════════════════════════════════════════
# Project Settings -> Database -> Connection string -> "URI"
# (use the pooled "Transaction" connection string, port 6543, for a
# long-running server process like this one)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL_REQUIRE=true

# Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Only needed as a fallback for legacy HS256-signed tokens. New projects
# sign tokens asymmetrically (ES256) by default and are verified against
# SUPABASE_URL's JWKS endpoint instead -- leave this blank unless your
# project still shows "JWT Secret" (not yet migrated) under Project
# Settings -> JWT Keys.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Storage -> create a private bucket (e.g. "lecture-uploads") -> Storage
# settings -> "S3 Connection" for the endpoint, then Storage -> Access Keys
# to create SUPABASE_S3_ACCESS_KEY_ID/SECRET. Leave SUPABASE_S3_BUCKET
# empty to keep storing uploaded files on local disk instead (dev only).
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1

# ── Guardrails ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=300
MAX_SYNC_LECTURE_DURATION_SECONDS=1200
THROTTLE_ANON_RATE=120/hour
THROTTLE_INGEST_RATE=5/hour
THROTTLE_CHAT_RATE=30/hour
THROTTLE_QUIZ_RATE=10/hour

# ══════════════════════════════════════════════════════════
# Pipeline (same variables as the original CLI project)
# ══════════════════════════════════════════════════════════
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

OUTPUT_LANGUAGE=mixed

CLEAN_CHUNK_CHAR_SIZE=6000
CLEAN_CHUNK_OVERLAP=500
ENFORCE_OUTPUT_LANGUAGE=true

EMBEDDING_MODEL=gemini-embedding-001
RAG_CHUNK_CHAR_SIZE=4000
RAG_CHUNK_CHAR_OVERLAP=600
RAG_TOP_K=5

RAG_CONFIDENCE_THRESHOLD=0.5
RAG_MAX_RETRIES=2
RAG_MAX_SUBQUERIES=4

QUIZ_BATCH_CHAR_SIZE=8000
QUIZ_DEFAULT_NUM_MCQ=10
QUIZ_DEFAULT_NUM_SHORT=5
QUIZ_DEFAULT_NUM_LONG=3
