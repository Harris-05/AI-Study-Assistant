# ══════════════════════════════════════════════════════════
# Django / deployment
# ══════════════════════════════════════════════════════════
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Comma-separated list of frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SQLite path (Render free tier: this file is wiped on every redeploy/
# restart/spin-down -- see README's "Known limitations" section)
SQLITE_PATH=

# Where uploaded files + pipeline work/ output live (defaults to backend/media)
MEDIA_ROOT=

# ── Guardrails ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=300
MAX_SYNC_LECTURE_DURATION_SECONDS=1200
THROTTLE_ANON_RATE=120/hour
THROTTLE_INGEST_RATE=5/hour
THROTTLE_CHAT_RATE=30/hour
THROTTLE_QUIZ_RATE=10/hour

# ══════════════════════════════════════════════════════════
# Pipeline (same variables as the original CLI project)
# ══════════════════════════════════════════════════════════
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite

OUTPUT_LANGUAGE=mixed

CLEAN_CHUNK_CHAR_SIZE=6000
CLEAN_CHUNK_OVERLAP=500
ENFORCE_OUTPUT_LANGUAGE=true

EMBEDDING_MODEL=gemini-embedding-001
RAG_CHUNK_CHAR_SIZE=4000
RAG_CHUNK_CHAR_OVERLAP=600
RAG_TOP_K=5

RAG_CONFIDENCE_THRESHOLD=0.5
RAG_MAX_RETRIES=2
RAG_MAX_SUBQUERIES=4

QUIZ_BATCH_CHAR_SIZE=8000
QUIZ_DEFAULT_NUM_MCQ=10
QUIZ_DEFAULT_NUM_SHORT=5
QUIZ_DEFAULT_NUM_LONG=3
